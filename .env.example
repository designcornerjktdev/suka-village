# Database: MariaDB/MySQL (Hostinger). Local: docker compose (port 3307).
DATABASE_URL="mysql://suka:suka@localhost:3307/suka"

# Secrets: long random strings
SESSION_SECRET=""
CRON_SECRET=""
# First admin ("admin" / admin@sukavillage.com), made by `npm run db:seed` only
# while there is no admin at all. Empty = a random password the seed prints
# once. Name, username and email are changed later in the admin, under Pengguna.
SEED_ADMIN_PASSWORD=""

# DOKU Direct API (SNAP). Dashboard: Integration > API Keys.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_ENV="sandbox"
# Our RSA private key (keys/ is git-ignored). Upload keys/doku-public.pem to
# the DOKU dashboard as the Merchant Public Key. PEM text in DOKU_PRIVATE_KEY
# also works (write line breaks as \n).
DOKU_PRIVATE_KEY_PATH="./keys/doku-private.pem"
# DOKU's public key, copied from the dashboard (checks DOKU's token request).
DOKU_PUBLIC_KEY_PATH="./keys/doku-server-public.pem"
# Per bank, the "Merchant BIN" column of the dashboard's VA table (e.g. 84923).
# Not "Partner Service ID" + "Prefix Customer No": DOKU refuses those. Leave a
# bank empty if it has no row.
DOKU_VA_BCA=""
DOKU_VA_BNI=""
DOKU_VA_BRI=""
DOKU_VA_MANDIRI=""
# 1 = virtual accounts through DOKU Checkout (Non-SNAP): the guest still picks
# the bank here, DOKU's page shows the number. Empty = SNAP, number on our page.
DOKU_VA_CHECKOUT="1"
# 1 = QRIS through DOKU Checkout too (no QRIS merchant/terminal id needed;
# the code shows in DOKU's pop-up). Empty = SNAP QRIS, needs the ids below.
DOKU_QRIS_CHECKOUT="1"
# 1 = DANA, ShopeePay and OVO through DOKU Checkout (pop-up). OVO only works
# this way (SNAP needs account binding); switch it on in Admin -> Pengaturan.
DOKU_EWALLET_CHECKOUT="1"
# 1 = cards through DOKU Checkout (pop-up). Empty = Credit Card Payment Page (new tab).
DOKU_CARD_CHECKOUT="1"
# QRIS (dashboard, once QRIS is approved): merchant and terminal id, and the
# property's postal code (digits only, max 5).
DOKU_QRIS_MERCHANT_ID=""
DOKU_QRIS_TERMINAL_ID=""
DOKU_QRIS_POSTAL_CODE=""

# Email (SMTP URL, e.g. smtps://user:pass@smtp.resend.com:465)
SMTP_URL=""
MAIL_FROM="Suka Village <reservasi@sukavillage.com>"

# Photo uploads: a folder OUTSIDE the app build, included in backups
UPLOAD_DIR="./uploads"

# Set last, on production only (docs/SEO.md §1)
SITE_URL=""
