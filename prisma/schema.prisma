// Suka Village database. The shapes the app sees are lib/booking/types.ts;
// lib/server/mappers.ts converts rows into them.
//
// MariaDB/MySQL (Hostinger Web and Cloud hosting). A plain String is
// VARCHAR(191) there, so anything that can be longer (DOKU payment URLs and QR
// strings, notes, reasons, history lines) is @db.Text. No partial indexes, no
// array columns; lists and bilingual text are Json (LONGTEXT on MariaDB). Stay
// dates are @db.Date (calendar days, Asia/Jakarta); event times are DateTime in
// UTC. Money is Int rupiah.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// pending | paid | confirmed | rejected | checked_in | completed | cancelled | expired
model Booking {
  code         String    @id
  status       String
  /// website | admin
  source       String
  /// id | en
  locale       String
  checkIn      DateTime  @db.Date
  checkOut     DateTime  @db.Date
  guests       Int
  guestName    String
  /// Empty for a booking the admin took over WhatsApp without an email.
  guestEmail   String
  /// E.164, +62...
  guestPhone   String
  notes        String?   @db.Text
  /// Quote frozen at booking time, night by night (lib/booking/types.ts Quote).
  quote        Json
  /// The promo applied, for counting its quota (also frozen inside quote).
  promoId      String?
  internalNote String?   @db.Text
  rejectReason String?   @db.Text
  /// Money reached us for a booking that is no longer a stay (rejected, or paid after it expired).
  refundOwed   Boolean   @default(false)
  /// Soft delete (UU PDP request or tidying); tax records keep the row.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  units         BookingUnit[]
  nights        Night[]
  payment       Payment?
  notifications Notification[]
  events        BookingEvent[]
  accessTokens  AccessToken[]
  charges       Charge[]

  @@index([status])
  @@index([checkIn])
  @@index([promoId])
}

model BookingUnit {
  bookingCode String
  unit        String
  booking     Booking @relation(fields: [bookingCode], references: [code], onDelete: Cascade)
  room        Room    @relation(fields: [unit], references: [unit])

  @@id([bookingCode, unit])
}

/// THE double-booking guard. One row per (room, night) that is taken, by a
/// holding booking or a block. Rows are deleted when a booking is released
/// (cancelled, expired, rejected) or a block is removed, so a plain unique
/// index is enough, on Postgres and MySQL alike.
model Night {
  id          Int      @id @default(autoincrement())
  unit        String
  date        DateTime @db.Date
  bookingCode String?
  blockId     String?
  booking     Booking? @relation(fields: [bookingCode], references: [code], onDelete: Cascade)
  block       Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([unit, date])
  @@index([bookingCode])
  @@index([blockId])
}

model Payment {
  bookingCode String    @id
  /// lib/booking/types.ts PaymentMethodId
  method      String
  amount      Int
  /// pending | paid | expired | failed | refunded
  status      String
  /// What the guest pays with: VA number, QR string, e-wallet or card URL.
  reference   String    @db.Text
  /// Our id for the charge at DOKU (VA trxId, QRIS partnerReferenceNo).
  gatewayId   String?
  /// DOKU's own id for the charge, where it has one (QRIS referenceNo).
  gatewayRef  String?
  expiresAt   DateTime
  paidAt      DateTime?
  booking     Booking   @relation(fields: [bookingCode], references: [code], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  bookingCode String
  /// lib/booking/types.ts TemplateId
  template    String
  to          String   @db.Text
  /// sent | failed
  status      String
  at          DateTime @default(now())
  booking     Booking  @relation(fields: [bookingCode], references: [code], onDelete: Cascade)

  @@index([bookingCode])
}

/// History card in the admin booking detail.
model BookingEvent {
  id          Int      @id @default(autoincrement())
  bookingCode String
  /// guest | admin | system | gateway
  by          String
  event       String   @db.Text
  adminId     String?
  at          DateTime @default(now())
  booking     Booking  @relation(fields: [bookingCode], references: [code], onDelete: Cascade)

  @@index([bookingCode])
}

/// Every charge ever opened at DOKU for a booking (one per payment method
/// tried). A guest who changes method can still pay an older charge that
/// DOKU cannot close (e-wallet links, card pages); its notification is then
/// matched here instead of being lost.
model Charge {
  trxId       String   @id @db.VarChar(64)
  bookingCode String
  method      String
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingCode], references: [code], onDelete: Cascade)

  @@index([bookingCode])
}

/// Signed-link access to the order page. Only the SHA-256 of the token is kept.
model AccessToken {
  hash        String   @id
  bookingCode String
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingCode], references: [code], onDelete: Cascade)

  @@index([bookingCode])
}

/// Nights closed by hand (or, later, by BookandLink).
model Block {
  id         String   @id @default(cuid())
  unit       String
  from       DateTime @db.Date
  /// Exclusive, like checkOut.
  to         DateTime @db.Date
  /// airbnb | booking_com | maintenance | owner | other
  reason     String
  note       String?  @db.Text
  /// manual | bookandlink
  source     String   @default("manual")
  externalId String?
  createdAt  DateTime @default(now())
  nights     Night[]
  room       Room     @relation(fields: [unit], references: [unit])

  @@index([unit])
}

model Room {
  unit        String        @id
  name        String
  size        Int
  bedrooms    Int
  bathrooms   Int
  /// Feature[]
  features    Json
  /// { id, en }
  description Json
  /// string[]
  photos      Json
  archived    Boolean       @default(false)
  position    Int           @default(0)
  rate        Rate?
  bookings    BookingUnit[]
  blocks      Block[]
}

model Rate {
  unit      String  @id
  weekday   Int
  /// Friday and Saturday nights.
  weekend   Int
  minNights Int     @default(1)
  maxGuests Int?
  bookable  Boolean @default(false)
  /// Season[]
  seasons   Json
  room      Room    @relation(fields: [unit], references: [unit])
}

model Promo {
  id          String    @id @default(cuid())
  /// Upper case, unique.
  code        String    @unique
  note        String?   @db.Text
  /// percent | amount
  kind        String
  value       Int
  maxDiscount Int?
  minNights   Int       @default(1)
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  /// UnitId[]; empty = every room
  units       Json
  quota       Int?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

/// One row (id = 1): lib/booking/types.ts Settings.
model Settings {
  id   Int  @id @default(1)
  data Json
}

model ContentItem {
  id       String
  /// home | facilities | experiences | events | explore | gallery | contact
  section  String
  position Int
  /// lib/booking/types.ts ContentItem minus id
  data     Json

  @@id([section, id])
}

/// Name and alt text (ID/EN) of a photograph, keyed by its src.
model Media {
  src  String @id
  name String
  alt  Json
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Optional for accounts made before usernames; lower-case, [a-z0-9._-]{3,32}.
  username     String?   @unique
  displayName  String    @default("")
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

/// DOKU notifications already handled (idempotency).
model WebhookEvent {
  id         String   @id @db.VarChar(255)
  receivedAt DateTime @default(now())
}

/// Fixed-window rate limit counters.
model RateHit {
  key         String   @db.VarChar(255)
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
}
